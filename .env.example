# BugSight QA - environment variables (copy to .env and adjust)

BUGSIGHT_WEIGHTS=runs/detect/runs/bugsight_yolov8n/weights/best.pt
BUGSIGHT_DATA_YAML=data/processed/data.yaml

FLASK_ENV=development
FLASK_DEBUG=1

# IMPORTANT: override this with a random string of 32+ bytes in production,
# e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
JWT_SECRET=change-me-to-a-random-32-byte-secret

# Access token lifetime in minutes (was hard-coded to Flask-JWT-Extended's
# 15-minute default before, with no refresh flow -> the app appeared to
# "stop working" after 15 min of use).
JWT_ACCESS_EXPIRES_MIN=60
# Refresh token lifetime in days.
JWT_REFRESH_EXPIRES_DAYS=30

# Initial admin account, created only when the database has no users yet.
# If the password is empty a random one is generated and printed in the logs.
BUGSIGHT_ADMIN_EMAIL=admin@bugsight.io
BUGSIGHT_ADMIN_PASSWORD=

# Upload size limit in MB (images and videos), and comma-separated CORS origins.
BUGSIGHT_MAX_UPLOAD_MB=200
BUGSIGHT_CORS_ORIGINS=*
